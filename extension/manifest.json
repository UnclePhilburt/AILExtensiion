{
  "manifest_version": 3,
  "name": "IMPACT Companion",
  "version": "0.4.4",
  "update_url": "https://unclephilburt.github.io/AILExtensiion/updates/updates.xml",
  "description": "Connect your IMPACT lead workflow to your phone: contact details, navigation, call registration and call results.",
  "action": {
    "default_title": "IMPACT Companion",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://mobile.impact.ailife.com/*"],
      "js": [
        "src/content/selector-config.js",
        "src/content/impact-diagnostic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "audioCapture",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://uawladqdbbbgddqtdjoi.supabase.co/*",
    "https://mobile.impact.ailife.com/*",
    "https://salebase.ai/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ]
}
